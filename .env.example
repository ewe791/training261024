# 推理后端：stub（流水线自测）| openai（在线接口）| local（本地 GPU）
FTKB_BACKEND=stub

# --- openai 兼容接口 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FTKB_BASE_MODEL=Qwen2.5-7B-Instruct
FTKB_FT_MODEL_ID=ft-kb-agent-4.1
FTKB_TEMPERATURE=0

# --- 本地 transformers + peft（云端训练完评测用这套）---
# 建议填绝对路径，避免 cd 到别处时相对路径失效
FTKB_BASE_MODEL_PATH=/root/autodl-tmp/Qwen2.5-7B-Instruct
FTKB_ADAPTER_PATH=/root/autodl-tmp/ft-kb-4.1/outputs/lora-knowledge-agent-4.1

# 显存 ≤16G 时打开 4bit 量化评测（会慢一些，精度影响很小）
FTKB_LOAD_4BIT=0
# 单条生成上限，评测答案都很短，512 足够
FTKB_MAX_NEW_TOKENS=512

# 中文日志避免乱码
PYTHONIOENCODING=utf-8
