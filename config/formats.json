{
  "_comment": "4.1.1 四种业务答案格式。required 为必须出现且按顺序出现的小节标记；ordered 表示要求分步编号。",
  "formats": {
    "制度解释": {
      "desc": "先给结论，再给条款依据，必要时补充适用范围与例外",
      "required": ["【结论】", "【依据】"],
      "optional": ["【适用范围】"],
      "ordered": false,
      "trigger": ["适用范围", "标准", "制度", "费用", "政策", "额度", "处罚", "流程规定"]
    },
    "产品说明": {
      "desc": "先说明功能，再说明使用方式，最后说明限制",
      "required": ["【功能】", "【使用方式】"],
      "optional": ["【限制】"],
      "ordered": false,
      "trigger": ["产品", "功能", "概述", "权限说明", "手册"]
    },
    "操作步骤": {
      "desc": "按顺序给出可执行步骤，每步以动词开头",
      "required": [],
      "optional": [],
      "ordered": true,
      "min_steps": 2,
      "trigger": ["流程", "步骤", "怎么操作", "如何申请", "导入", "审批"]
    },
    "故障处理": {
      "desc": "先描述现象，再说明原因，最后给出处理办法",
      "required": ["【现象】", "【处理】"],
      "optional": ["【原因】"],
      "ordered": false,
      "trigger": ["故障", "报错", "为什么", "看不到", "失败", "常见问题"]
    }
  }
}
